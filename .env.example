# Copy this file to .env and fill in your real credentials
# .env is in .gitignore so it will never be pushed to GitHub

# OANDA credentials
OANDA_TOKEN=your_api_token_here
OANDA_ACCOUNT=your_account_id_here
OANDA_PRACTICE=true

# MT5 credentials (Windows only)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
